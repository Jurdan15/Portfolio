<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="bot.LoginPage"
    Title="Login"
    BackgroundColor="{StaticResource PageBackgroundColor}">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">

        <!-- Logo -->
        <Image Source="logo.png"
               HeightRequest="250"
               WidthRequest="250"
               HorizontalOptions="Center"/>

        <!-- Welcome Text -->
        <Label Text="Welcome Back," 
               FontSize="40"
               FontAttributes="Bold"
               FontFamily="arial"
               HorizontalOptions="Center"
               TextColor="{StaticResource TextColor}" />

        <Label Text="Admin!"
               TextColor="{StaticResource HeaderBackgroundColor}"
               FontFamily="arial"
               FontSize="40"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Password Entry -->
        <Entry x:Name="PasswordEntry"
               Placeholder="Password"
               IsPassword="True" 
               FontSize="24"
               FontAttributes="Bold"
               WidthRequest="300"
               HorizontalOptions="Center"
               BackgroundColor="{StaticResource EntryBackgroundColor}"
               TextColor="{StaticResource EntryTextColor}" />

        <!-- Login Button -->
        <Button Text="Login"
                BackgroundColor="Green"
                TextColor="White"
                CornerRadius="5"
                FontSize="24"
                FontAttributes="Bold"
                WidthRequest="300"
                HorizontalOptions="Center"
                Clicked="OnLoginClicked" />

    </VerticalStackLayout>

</ContentPage>
