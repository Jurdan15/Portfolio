<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="bot.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme Resource Keys -->
            <Color x:Key="PageBackgroundColor">White</Color>
            <Color x:Key="TextColor">Black</Color>
            <Color x:Key="HeaderBackgroundColor">Maroon</Color>
            <Color x:Key="EntryBackgroundColor">Maroon</Color>
            <Color x:Key="EntryTextColor">White</Color>

            <!-- Add these new resources for theme toggle -->
            <Color x:Key="ThemeToggleTrackColor">#E0E0E0</Color>
            <Color x:Key="ThemeToggleThumbColor">#FFFFFF</Color>

            <Shadow x:Key="ThemeToggleShadow"
                    Brush="Black"
                    Opacity="0.2"
                    Radius="4"
                    Offset="0,2"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>